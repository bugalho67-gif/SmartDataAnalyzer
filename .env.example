# =========================
# APPLICATION
# =========================

APP_NAME=SmartDataAnalyzer
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True


# =========================
# DATABASE
# =========================

DATABASE_URL=sqlite:///smartdata.db


# =========================
# AI
# =========================

AI_PROVIDER=local
AI_MODEL=
AI_TEMPERATURE=0.2


# =========================
# SECURITY
# =========================

SECRET_KEY=change_this_key
SESSION_TIMEOUT=3600


# =========================
# UPLOAD
# =========================

MAX_UPLOAD_SIZE_MB=200

UPLOAD_FOLDER=uploads


# =========================
# CACHE
# =========================

CACHE_TIMEOUT=3600


# =========================
# LOGGING
# =========================

LOG_LEVEL=INFO
LOG_FOLDER=logs
# =========================
# AI
# =========================

AI_PROVIDER=local
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2
OPENAI_API_KEY=sk-...
